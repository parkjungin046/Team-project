# 이 파일은 예시용 템플릿입니다. 실제 비밀번호(해시)는 .env 파일에 저장되며,
# .env는 .gitignore에 등록되어 있어 GitHub에는 절대 올라가지 않습니다.
#
# 비밀번호를 설정/변경하려면 아래 명령어를 사용하세요. (평문 비밀번호가 파일이나
# git 기록에 남지 않고, bcrypt 해시값만 .env에 저장됩니다)
#   npm run set-admin-password -- "새비밀번호"

# 관리자 로그인 비밀번호의 bcrypt 해시값 (평문 저장 금지)
ADMIN_PASSWORD_HASH=

# 관리자 서버 포트 (기본값 4300, Render 등에 배포하면 자동으로 PORT가 대신 쓰임)
ADMIN_PORT=4300

# ----------------------------------------------------------------------------
# 아래 두 값은 로컬에서는 비워두면 됩니다 (로컬 파일 저장소를 그대로 사용).
# Render 등에 배포할 때만 필요하며, render.yaml을 통해 자동으로 채워집니다.
# ----------------------------------------------------------------------------

# PostgreSQL 연결 문자열. 값이 있으면 자동으로 파일 저장 대신 PostgreSQL을 사용합니다.
DATABASE_URL=

# production으로 설정하면 0.0.0.0으로 열리고, 쿠키에 secure(https 전용) 옵션이 켜집니다.
NODE_ENV=
